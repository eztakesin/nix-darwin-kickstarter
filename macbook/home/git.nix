{
  lib,
  pkgs,
  username,
  useremail,
  my,
  ...
}: let
  # Wrap git so every commit/tag/merge/rebase records UTC (+0000) instead of
  # leaking the host's local timezone (Asia/Bangkok, +0700).
  #
  # Wrapping the package (rather than a shell alias/function) covers all
  # callers: fish/bash, lazygit, neovim/fugitive, GUI editors, scripts,
  # git aliases (`git cmt`/`git ca`), and `git -C ... commit`.
  # `makeBinaryWrapper` avoids /bin/sh startup overhead on frequent status
  # calls. `--set TZ UTC` pins UTC unconditionally even if a parent process
  # exports TZ; OpenPGP signatures store UTC epoch seconds (RFC 4880), so
  # `commit.gpgSign` is unaffected.
  gitUtc = pkgs.symlinkJoin {
    name = "git-utc-${pkgs.git.version}";
    paths = [pkgs.git];
    nativeBuildInputs = [pkgs.makeBinaryWrapper];
    postBuild = ''
      wrapProgram $out/bin/git --set TZ UTC
    '';
    # home-manager's programs.git calls `lib.getExe cfg.package`, which reads
    # `meta.mainProgram` (not propagated by symlinkJoin automatically).
    meta = pkgs.git.meta;
  };
in {
  # `programs.git` will generate the config file: ~/.config/git/config
  # to make git use this config file, `~/.gitconfig` should not exist!
  #
  #    https://git-scm.com/docs/git-config#Documentation/git-config.txt---global
  home.activation.removeExistingGitconfig = lib.hm.dag.entryBefore ["checkLinkTargets"] ''
    rm -f ~/.gitconfig
  '';

  # Syntax-highlighting pager for git (moved out of programs.git.delta,
  # which home-manager renamed to this top-level option)
  programs.delta = {
    enable = true;
    enableGitIntegration = true;
  };

  programs.git = {
    enable = true;
    package = gitUtc;
    lfs.enable = true;

    ignores = ["*~" "*.swp" "\\#*\\#" ".\\#*" ".vim/coc-settings.json" ".vscode" ".envrc"]; # vim swap file & emacs

    # Work identity overrides for any repo under ~/work/.
    # The included file is generated by home-manager from `contents`
    # below — no manual ~/work/.gitconfig needed.
    includes = [
      {
        condition = "gitdir:~/work/";
        contents = {
          user = {
            name = my.gpg.work.name;
            email = my.gpg.work.email;
            signingKey = my.gpg.work.fingerprint;
          };
        };
      }
    ];

    settings = {
      # User & signing — personal identity (default outside ~/work/).
      # Email must match a UID on the GPG key AND a verified email on
      # the GitHub account, otherwise GitHub marks commits Unverified
      # even though the signature is real.
      user.name = my.gpg.personal.name;
      user.email = my.gpg.personal.email;
      user.signingKey = my.gpg.personal.fingerprint;
      commit.gpgSign = true;
      tag.gpgSign = true;

      # Pull.
      pull.ff = "only";

      # Rebase.
      rebase.autoSquash = true;
      rebase.abbreviateCommands = true;

      # Diff & merge.
      # NOT diff.external = difft: that would route ALL `git diff` output
      # through difftastic, bypassing delta (programs.delta above owns the
      # everyday diff/log/show/blame rendering). difftastic stays available
      # on demand via `git dft` (alias below).
      difftool.difftastic.cmd = "${pkgs.difftastic}/bin/difft \"$LOCAL\" \"$REMOTE\"";
      diff.tool = "nvimdiff";
      difftool.prompt = false;
      merge.tool = "nvimdiff";
      merge.conflictstyle = "zdiff3";
      mergetool.prompt = false;
      rerere.enabled = true;

      # Pager.
      # No core.pager here: delta's enableGitIntegration already sets the
      # per-command pagers (diff/log/show/blame) and the interactive diff
      # filter; everything else falls back to git's default (less).
      pager.branch = "less --quit-if-one-screen";
      pager.stash = "less --quit-if-one-screen";

      # Display.
      # Always show branches and tags for `git log` in `vim-fugitive`.
      # See: https://github.com/tpope/vim-fugitive/issues/1965
      log.decorate = true;
      # Show detailed diff by default for `git stash show`.
      stash.showPatch = true;

      # Misc.
      init.defaultBranch = "main";
      push.autoSetupRemote = true;
      advice.detachedHead = false;

      # NOTE: the section must be `alias` (singular) — git ignores an
      # `[aliases]` section entirely.
      alias = {
        # common aliases
        br = "branch";
        cmt = "commit -m";
        ca = "commit --amend -m";
        co = "checkout";
        cp = "cherry-pick";
        d = "diff";
        dc = "diff --cached";
        dt = "difftool";
        # structural (AST-aware) diff via difftastic, on demand
        dft = "difftool --tool difftastic";
        ls = "log --pretty=format:\"%C(yellow)%h%Cred%d\\\\ %Creset%s%Cblue\\\\ [%cn]\" --decorate";
        ll = "log --pretty=format:\"%C(yellow)%h%Cred%d\\\\ %Creset%s%Cblue\\\\ [%cn]\" --decorate --numstat";
        mt = "mergetool";
        st = "status";
        sub = "submodule";

        # aliases for submodule
        update = "submodule update --init --recursive";
        foreach = "submodule foreach";
      };
    };

    # signing = {
    #   key = "xxx";
    #   signByDefault = true;
    # };

    # delta = {
    #   enable = true;
    #   options = {
    #     features = "side-by-side";
    #   };
    # };
  };
}
